{
  "name": "@germanescobar/ada",
  "version": "0.1.0",
  "description": "An intelligent AI-powered coding agent that helps you write, edit, and run code with conversational access to AI models and your file system.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/germanescobar/ada.git"
  },
  "bugs": {
    "url": "https://github.com/germanescobar/ada/issues"
  },
  "homepage": "https://github.com/germanescobar/ada#readme",
  "bin": {
    "ada": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "start": "node dist/index.js",
    "eval": "tsx evals/run.ts",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.77.0",
    "commander": "^13.1.0",
    "chalk": "^5.4.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0"
  }
}
